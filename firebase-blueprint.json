{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A showcase project in the academic or professional portfolio.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "liveUrl": { "type": "string" },
        "repositoryUrl": { "type": "string" },
        "techStack": { "type": "array", "items": { "type": "string" } },
        "coverImage": { "type": "string" },
        "isFeatured": { "type": "boolean" },
        "isPublished": { "type": "boolean" },
        "addedDate": { "type": "string" }
      },
      "required": [
        "id",
        "title",
        "description",
        "liveUrl",
        "repositoryUrl",
        "techStack",
        "coverImage",
        "isFeatured",
        "isPublished",
        "addedDate"
      ]
    },
    "HeroInfo": {
      "title": "HeroInfo",
      "description": "The personal profile branding and main landing intro attributes.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "professionalTitle": { "type": "string" },
        "tagline": { "type": "string" },
        "location": { "type": "string" },
        "bio": { "type": "string" },
        "profilePhoto": { "type": "string" },
        "cvName": { "type": "string" },
        "cvLastUpdated": { "type": "string" }
      },
      "required": [
        "fullName",
        "professionalTitle",
        "tagline",
        "location",
        "bio",
        "profilePhoto",
        "cvName",
        "cvLastUpdated"
      ]
    },
    "Certification": {
      "title": "Certification",
      "description": "Academic, corporate, or skill certifications earned.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "issuer": { "type": "string" },
        "issueDate": { "type": "string" },
        "url": { "type": "string" }
      },
      "required": ["id", "title", "issuer", "issueDate"]
    },
    "Message": {
      "title": "Message",
      "description": "Contact form submissions from external site visitors.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "isRead": { "type": "boolean" }
      },
      "required": ["id", "name", "email", "subject", "message", "timestamp", "isRead"]
    },
    "User": {
      "title": "User",
      "description": "Administrative user or manager metadata record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "fullName": { "type": "string" },
        "role": { "type": "string" },
        "disabled": { "type": "boolean" }
      },
      "required": ["userId", "email"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Portfolio projects collection"
    },
    "/hero_info/{heroId}": {
      "schema": "HeroInfo",
      "description": "Branding content of the hero section"
    },
    "/certifications/{certificationId}": {
      "schema": "Certification",
      "description": "Array of user certifications"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Submitted contact inquiries"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User details and accounts for CMS editing"
    }
  }
}
